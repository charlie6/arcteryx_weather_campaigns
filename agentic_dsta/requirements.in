# The langchain, ag2 and llama_index extras were dropped. Nothing in this
# codebase imports LangChain, AutoGen or LlamaIndex -- they were boilerplate
# from the agent-starter-pack template -- and the langchain extra pins
# langchain-google-genai<4.2.3, every release of which requires
# google-genai<2.0.0. That directly contradicts google-adk>=2.9, which requires
# google-genai>=2.19, and makes the dependency set unresolvable.
#
# The >=1.160.0 floor matters too: the `adk` extra caps google-adk<2.0.0 up to
# and including 1.155.0, and only widens to <3.0.0 in 1.160.0.
google-cloud-aiplatform[agent_engines,adk]>=1.160.0,<2
