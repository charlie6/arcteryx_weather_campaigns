# Google Cloud
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"
GOOGLE_CLOUD_PROJECT="YOUR_GOOGLE_CLOUD_PROJECT"
GOOGLE_CLOUD_LOCATION="us-central1"
# API_HUB_LOCATION="us-west1"  # Optional: override if API Hub instance is in a different region than GOOGLE_CLOUD_LOCATION
GOOGLE_GENAI_USE_VERTEXAI="True"
LOG_LEVEL="INFO"

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN="YOUR_GOOGLE_ADS_DEVELOPER_TOKEN"
GOOGLE_ADS_CLIENT_ID="YOUR_GOOGLE_ADS_CLIENT_ID"
GOOGLE_ADS_CLIENT_SECRET="YOUR_GOOGLE_ADS_CLIENT_SECRET"
GOOGLE_ADS_REFRESH_TOKEN="YOUR_GOOGLE_ADS_REFRESH_TOKEN"
# Manager (MCC) account for the login-customer-id header. Leave unset to fall
# back to the target customer ID. Dashes are stripped automatically.
#GOOGLE_ADS_LOGIN_CUSTOMER_ID="YOUR_MCC_CUSTOMER_ID"

# Performance Max asset group safety guards
# Asset groups whose name contains any of these (case-insensitive) are treated
# as always-on and can never be paused.
#ADSTA_ALWAYS_ON_ASSET_GROUP_PATTERNS="ALWAYS_ON,ALWAYSON,ALWAYS-ON,_AO_"
# Only asset groups whose name contains this substring may be paused.
# Set to an empty string to disable the allow-list.
#ADSTA_ASSET_GROUP_MANAGED_PATTERN="_WEATHER_"

# APIs
#GOOGLE_POLLEN_API_KEY="YOUR_GOOGLE_POLLEN_API_KEY"
#GOOGLE_WEATHER_API_KEY="YOUR_GOOGLE_WEATHER_API_KEY"

# Gemini Model
GEMINI_MODEL="gemini-2.5-pro"

# Firestore
FIRESTORE_DB="YOUR_FIRESTORE_DB"
