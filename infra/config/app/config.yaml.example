# Google Cloud Project Configuration
project_id: "YOUR_PROJECT_ID"
region: "YOUR_REGION"

# Resource Naming
resource_prefix: "YOUR_RESOURCE_PREFIX"
allow_unauthenticated: true
log_level: "INFO"

# Monitoring (alerts + "ADSTA Operations" dashboard).
# Every alert emails these addresses. Leave empty to see alerts only in the
# Cloud Monitoring console. Slack/PagerDuty/Chat channels created in the console
# can be attached with alert_additional_notification_channel_ids.
enable_monitoring: true
alert_notification_emails: []
#  - "adsta-oncall@example.com"
# How long without a completed run before the missed-run alert fires. Keep a
# little above the gap between the scheduler runs below. The SA360 entry is
# ignored while enable_sa360 is false.
monitoring_heartbeat_windows:
  GoogleAds: "13h"
  SA360: "25h"

# Firestore Configuration
firestore_database_type: "FIRESTORE_NATIVE"

#Scheduler Cron
# The Arc'teryx spec (section 4.2) asks for two runs per day, weighted to the
# morning: 06:00 as the decision run and 18:00 as the catch-up. This MUST agree
# with schedule.runsPerDay in the account's GoogleAdsConfig document, because the
# trailing window is expressed in hours but enforced in runs. A once-daily cron
# with runsPerDay 2 in Firestore turns a 24-hour trailing window into 48 hours.
googleads_scheduler_schedule: "0 6,18 * * *"
sa360_scheduler_schedule: "5 10 * * *"
# Timezone for both scheduler jobs. Each account should run in its own local
# time, so a multi-account rollout needs one deployment per account.
sa_run_sse_scheduler_job_timezone: "America/Vancouver"

# Gemini model configuration.
# gemini_location is NOT the Cloud Run region. Cloud Run stays in `region`
# (e.g. us-central1), but Gemini 3.x models are only served from the `us`, `eu`,
# and `global` endpoints -- never from a single US region.
gemini_model: "gemini-3.5-flash"
gemini_location: "us"

additional_secrets: ["GOOGLE_API_KEY"]
#  - MY_CUSTOM_API_KEY
#  - ANOTHER_API_SECRET

#Google Ads Customer ID to be triggered from cloud scheduler
googleads_customer_id: "GOOGLE_ADS_CUSTOMER_ID"

# Auth and MCC Configuration
google_ads_force_user_creds: "true"
# The manager (MCC) account used for the login-customer-id header. Leave blank
# to fall back to the target customer ID. Dashes are stripped automatically.
google_ads_login_customer_id: "YOUR_MCC_CUSTOMER_ID"

# SA360 is optional. With enable_sa360 false no SA360 scheduler job is created,
# so sa360_customer_id is unused.
enable_sa360: false
#SA360 Customer ID to be triggered from cloud scheduler
sa360_customer_id: "SA360_CUSTOMER_ID"

# Extra environment variables for the Cloud Run service. This map REPLACES the
# Terraform default, so keep GOOGLE_GENAI_USE_VERTEXAI here when you override it.
# ADSTA_DRY_RUN is the log-only switch: any truthy value suppresses every Google
# Ads mutation and SA360 sheet write at the point of the write, while Firestore
# state and the ChangeLog still advance. Keep it on for the first validation run
# against a live account, then remove it to go live.
run_service_env_vars:
  GOOGLE_GENAI_USE_VERTEXAI: "True"
  ADSTA_DRY_RUN: "true"